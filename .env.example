# --- Database (Postgres) ---
# For local dev, run Postgres in Docker, e.g.:
#   docker run --name onboarding-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onboarding

# --- Auth.js v5 ---
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
# Base URL of the app (used by Auth.js for callbacks)
AUTH_URL=http://localhost:3000
# Trust the host header in dev (set to false / unset in prod behind a fixed AUTH_URL)
AUTH_TRUST_HOST=true

# --- Email (Auth.js magic links) ---
# Phase 1 uses a console transport in dev; production should configure these.
EMAIL_FROM="Onboarding Portal <noreply@example.com>"
EMAIL_SERVER=

# --- File storage (Phase 1: local dev only) ---
# Storage adapter: "local" (dev only, do NOT use in production) or "supabase" (Phase 5+)
STORAGE_ADAPTER=local
LOCAL_STORAGE_DIR=./.uploads

# Required when STORAGE_ADAPTER=supabase (server-only — do NOT prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=teacher-onboarding-private

# --- Seed defaults (used by scripts/seed.ts) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME="School Admin"
SEED_ADMIN_PASSWORD=ChangeMe!Now
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_NAME="Sample Teacher"
SEED_TEACHER_PASSWORD=ChangeMe!Now

# --- Cron ---
CRON_SECRET=replace-with-long-random-string

# --- Email reminders (Phase 6) ---
# Provider for outbound reminder emails. Default is `console` for dev (prints
# every payload to stdout, no network call). For production use `resend`.
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend. Server-only secret — do NOT prefix
# with NEXT_PUBLIC_. The build-time leakage check (`pnpm test:leakage`)
# verifies the value never appears in .next/static/**.
RESEND_API_KEY=
